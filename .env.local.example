# Claude API - question engine, tagging, cleanup pass
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Speech-to-text: no key needed. Voice answers use the browser's built-in
# Web Speech API (client-side, free, live) - see components/VoiceRecorder.tsx.

# Google OAuth client - Drive access (drive.file scope)
# See README.md "Google Drive setup" for exact steps.
# Names must be AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET - that's the convention
# NextAuth v5 auto-detects for a provider named "google".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
