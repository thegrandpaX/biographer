# Claude API - question engine, tagging, cleanup pass
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API - speech-to-text for voice answers (native audio understanding)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google OAuth client - Drive access (drive.file scope)
# See README.md "Google Drive setup" for exact steps.
# Names must be AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET - that's the convention
# NextAuth v5 auto-detects for a provider named "google".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
